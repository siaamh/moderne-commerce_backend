# Copy this file to .env and fill in all values before running the project.
# Never commit the .env file to version control.

# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (must match the db service in compose.yaml)
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI providers — set OPENROUTER_API_KEY to use OpenRouter (recommended)
# OpenRouter supports 100+ models via one key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8742
OPENROUTER_SITE_NAME=VERDANT Shopping Assistant

# Fallback: direct OpenAI or Anthropic (used only if OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP / Chat settings
MCP_TIMEOUT=30
MCP_MEDIA_BASE_URL=http://localhost:8742

# Production TLS (set to True only when behind an HTTPS terminator)
SECURE_SSL_REDIRECT=False
